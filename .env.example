# Environment Configuration Template for SMS Gateway Android
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables with examples and documentation

# =============================================================================
# ANDROID BUILD CONFIGURATION
# =============================================================================

# Android Keystore Password
# Purpose: Password for the Android keystore file used to sign release builds
# Format: String (alphanumeric)
# Default: None (required for release builds)
SIGNING_STORE_PASSWORD=your-keystore-password

# Android Key Alias
# Purpose: Alias of the key within the keystore used for signing release builds
# Format: String (alphanumeric)
# Default: None (required for release builds)
SIGNING_KEY_ALIAS=your-key-alias

# Android Key Password
# Purpose: Password for the specific key alias in the keystore
# Format: String (alphanumeric)
# Default: None (required for release builds)
SIGNING_KEY_PASSWORD=your-key-password
