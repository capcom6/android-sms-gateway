# Environment Configuration Template for SMS Gateway for Android
# Copy this file to .env and fill in your actual values.
# Required only when building signed release artifacts; local debug builds do not need these.
# The app itself has no runtime environment variables — signing variables are read by Gradle
# (app/build.gradle) at build time.

# =============================================================================
# SIGNING CONFIGURATION
# =============================================================================

# Keystore Store Password
# Purpose: Password protecting the release keystore, read by the Gradle build
#          (app/build.gradle) to configure the release signingConfig.
# Format: String
# Example: change-me
SIGNING_STORE_PASSWORD=change-me

# Keystore Key Alias
# Purpose: Alias of the signing key inside the release keystore used to sign
#          the release APK/AAB (app/build.gradle signingConfig).
# Format: String
# Example: capcom6
SIGNING_KEY_ALIAS=capcom6

# Keystore Key Password
# Purpose: Password for the key referenced by SIGNING_KEY_ALIAS.
# Format: String
# Example: change-me
SIGNING_KEY_PASSWORD=change-me

# =============================================================================
# CI/CD CONFIGURATION
# =============================================================================
# These environment variables are consumed by the GitHub Actions workflows
# (.github/workflows/build-apk.yml, pr-build.yml, release-build.yml) when
# producing signed release artifacts. The keystore file and Firebase config are
# passed as CI secrets, not stored in the repository:
#   - signing-key-store-base64  -> base64-encoded app/keystore.jks
#   - signing-key-alias         -> matches SIGNING_KEY_ALIAS
#   - signing-key-password      -> matches SIGNING_KEY_PASSWORD
#   - signing-store-password    -> matches SIGNING_STORE_PASSWORD
#   - google-services-json      -> base64-encoded app/google-services.json

# Keystore File Path (CI only)
# Purpose: Destination path where the base64-encoded keystore is decoded before
#          signing in the GitHub Actions build pipeline.
# Format: File path
# Default: app/keystore.jks
# Example: app/keystore.jks
SIGNING_KEY_STORE_PATH=app/keystore.jks